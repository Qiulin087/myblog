---
import JournalFeed from "@components/journal/JournalFeed.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getJournalItems } from "@/lib/journal";

const items = await getJournalItems();
---

<MainGridLayout title="记录" description="秋林的随笔、学习理解与生活记录，按时间倒序排列。">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative shadow-sm border border-[var(--line-color,rgba(0,0,0,0.06))] dark:border-white/5">
        <div class="card-base z-10 relative w-full !bg-[var(--card-bg)]">
            <div class="px-6 md:px-8 pt-6 pb-4 border-b border-[var(--line-divider)] flex items-center justify-between">
                <div>
                    <h1 class="text-xl md:text-2xl font-bold text-[var(--sp-ink,#2d485d)] dark:text-[var(--sp-ink,#cfdee9)]">
                        我的记录
                    </h1>
                    <p class="text-sm text-[var(--sp-sub,#587689)] dark:text-[var(--sp-sub,#8ba2b5)] mt-1">
                        随笔、学习理解与生活记录，按时间倒序排列。
                    </p>
                </div>
            </div>
            <JournalFeed items={items} />
        </div>
    </div>
</MainGridLayout>
