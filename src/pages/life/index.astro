---
import LifeEntry from "@components/journal/LifeEntry.astro";
import SoftLayout from "@layouts/SoftLayout.astro";
import { url } from "@utils/url-utils";
import { getLifeEntries } from "@/lib/journal";

const entries = await getLifeEntries();
---

<SoftLayout title="生活记录" description="秋林的日常照片与生活瞬间。">
    <div class="page">
        <header class="page-head">
            <p class="back">
                <a href={url("/")}>← 返回首页</a>
            </p>
            <h1>生活记录</h1>
            <p class="sub">一些平凡又值得留下的瞬间。</p>
        </header>

        {
            entries.length === 0 ? (
                <p class="empty">还没有记录，生活正在继续。</p>
            ) : (
                <div class="list">
                    {entries.map((e) => (
                        <div class="entry-row">
                            <LifeEntry
                                item={{
                                    type: "life",
                                    date: e.data.published,
                                    text: e.body,
                                    photos: e.data.photos,
                                }}
                            />
                        </div>
                    ))}
                </div>
            )
        }
    </div>
</SoftLayout>

<style>
    .page {
        width: 100%;
        max-width: 46rem;
        margin: 0 auto;
        padding: 1.5rem 0 4rem;
    }

    .back {
        margin: 0 0 2rem;
        font-size: 0.8125rem;
    }

    .back a {
        color: var(--sp-sub);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .back a:hover,
    .back a:focus-visible {
        color: var(--sp-accent-strong);
    }

    h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.015em;
        color: var(--sp-ink);
    }

    .sub {
        margin: 0.5rem 0 0;
        font-size: 0.9375rem;
        line-height: 1.8;
        color: var(--sp-sub);
    }

    .empty {
        margin: 5rem 0;
        text-align: center;
        color: var(--sp-sub);
        font-size: 0.9375rem;
    }

    .list {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .entry-row {
        padding: 1.5rem 0.5rem;
        border-top: 1px solid var(--sp-line);
    }

    .list .entry-row:first-child {
        border-top: none;
        padding-top: 0.5rem;
    }
</style>
