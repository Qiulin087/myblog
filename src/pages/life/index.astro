---
import SoftLayout from "@layouts/SoftLayout.astro";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { url } from "@utils/url-utils";
import { getLifeEntries } from "@/lib/journal";

const entries = await getLifeEntries();
---

<SoftLayout title="生活记录" description="秋林的日常照片与生活瞬间。">
    <div class="page">
        <header class="page-head">
            <p class="back">
                <a href={url("/")}>← 返回首页</a>
            </p>
            <h1>生活记录</h1>
            <p class="sub">一些平凡又值得留下的瞬间。</p>
        </header>

        {
            entries.length === 0 ? (
                <p class="empty">还没有记录，生活正在继续。</p>
            ) : (
                <div class="list">
                    {entries.map((e) => (
                        <article class="row">
                            <p class="meta">
                                <time datetime={e.data.published.toISOString()}>
                                    {formatDateToYYYYMMDD(e.data.published)}
                                </time>
                            </p>
                            {e.body && <p class="text">{e.body}</p>}
                            {e.data.photos.length > 0 && (
                                <div class="life-photos">
                                    {e.data.photos.map((src) => (
                                        <img src={src} alt="" loading="lazy" />
                                    ))}
                                </div>
                            )}
                        </article>
                    ))}
                </div>
            )
        }
    </div>
</SoftLayout>

<style>
    .page {
        width: 100%;
        max-width: 46rem;
        margin: 0 auto;
        padding: 1.5rem 0 4rem;
    }

    .back {
        margin: 0 0 2.5rem;
        font-size: 0.8125rem;
    }

    .back a {
        color: var(--sp-sub);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .back a:hover,
    .back a:focus-visible {
        color: var(--sp-accent-strong);
    }

    h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--sp-ink);
    }

    .sub {
        margin: 0.75rem 0 0;
        font-size: 0.9375rem;
        line-height: 1.8;
        color: var(--sp-sub);
    }

    .list {
        margin-top: 2.5rem;
    }

    .row {
        padding: 1.375rem 0 1.5rem;
        border-top: 1px solid var(--sp-line);
    }

    .list .row:first-child {
        border-top: none;
        padding-top: 0.5rem;
    }

    .meta {
        margin: 0 0 0.375rem;
        font-size: 0.8125rem;
        color: var(--sp-sub);
        font-variant-numeric: tabular-nums;
    }

    .text {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.9;
        color: var(--sp-ink);
        white-space: pre-line;
    }

    .life-photos {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 0.625rem;
        margin-top: 0.75rem;
    }

    .life-photos img {
        height: clamp(8.75rem, 26vw, 13.75rem);
        width: auto;
        border-radius: 10px;
        display: block;
        cursor: zoom-in;
    }

    .empty {
        margin: 5rem 0;
        text-align: center;
        color: var(--sp-sub);
        font-size: 0.9375rem;
    }
</style>
