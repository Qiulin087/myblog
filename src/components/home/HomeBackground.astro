---
// HomeBackground.astro - Interactive Particle Constellation Canvas + Aurora Gradient Mesh
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <!-- HTML5 Interactive Particle & Constellation Canvas -->
    <canvas id="bg-canvas" class="absolute inset-0 w-full h-full opacity-70 dark:opacity-95"></canvas>

    <!-- Multi-layer Flowing Aurora Glow Mesh -->
    <div class="absolute inset-0 overflow-hidden opacity-40 dark:opacity-60">
        <div class="absolute -top-40 -left-40 w-[550px] h-[550px] md:w-[700px] md:h-[700px] bg-primary-container/40 dark:bg-primary-container/60 rounded-full blur-[120px] md:blur-[160px] animate-gradient-slow"></div>
        <div class="absolute top-1/3 -right-40 w-[550px] h-[550px] md:w-[700px] md:h-[700px] bg-tertiary-container/30 dark:bg-tertiary-container/50 rounded-full blur-[120px] md:blur-[160px] animate-gradient-slow" style="animation-delay: -6s;"></div>
        <div class="absolute -bottom-40 left-1/3 w-[550px] h-[550px] md:w-[700px] md:h-[700px] bg-secondary-container/40 dark:bg-secondary-container/60 rounded-full blur-[120px] md:blur-[160px] animate-gradient-slow" style="animation-delay: -12s;"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(154,168,255,0.12),transparent_65%)]"></div>
    </div>
</div>

<script>
    function setupBackgroundCanvas() {
        const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let width = 0;
        let height = 0;
        let animationFrameId: number | null = null;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobile = window.innerWidth < 768;

        const mouse = {
            x: null as number | null,
            y: null as number | null,
            targetX: null as number | null,
            targetY: null as number | null,
            radius: 260,
            speed: 0
        };

        interface Ripple {
            x: number;
            y: number;
            radius: number;
            maxRadius: number;
            alpha: number;
        }

        const ripples: Ripple[] = [];

        function resize() {
            if (!canvas) return;
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }

        resize();
        window.addEventListener('resize', resize, { passive: true });

        const handleMouseMove = (e: MouseEvent) => {
            if (mouse.x === null || mouse.y === null) {
                mouse.x = e.clientX;
                mouse.y = e.clientY;
                mouse.targetX = e.clientX;
                mouse.targetY = e.clientY;
            } else {
                mouse.targetX = e.clientX;
                mouse.targetY = e.clientY;
            }
        };

        const handleMouseLeave = () => {
            mouse.x = null;
            mouse.y = null;
            mouse.targetX = null;
            mouse.targetY = null;
        };

        const handleClick = (e: MouseEvent) => {
            ripples.push({
                x: e.clientX,
                y: e.clientY,
                radius: 12,
                maxRadius: Math.max(width, height) * 0.65,
                alpha: 0.95
            });
        };

        window.addEventListener('mousemove', handleMouseMove, { passive: true });
        window.addEventListener('mouseleave', handleMouseLeave, { passive: true });
        window.addEventListener('click', handleClick, { passive: true });

        class Particle {
            x = 0;
            y = 0;
            vx = 0;
            vy = 0;
            size = 0;
            baseAlpha = 0;
            energy = 0;
            breathSpeed = 0;
            breathOffset = 0;
            currentSize = 0;

            constructor() {
                this.reset();
            }

            reset() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.vx = (Math.random() - 0.5) * 1.2;
                this.vy = (Math.random() - 0.5) * 1.2;
                this.size = Math.random() * 2.8 + 1.2;
                this.baseAlpha = Math.random() * 0.6 + 0.3;
                this.energy = 0;
                this.breathSpeed = 0.02 + Math.random() * 0.03;
                this.breathOffset = Math.random() * Math.PI * 2;
                this.currentSize = this.size;
            }

            update(time: number) {
                this.x += this.vx;
                this.y += this.vy;

                if (this.x < 0) this.x = width;
                if (this.x > width) this.x = 0;
                if (this.y < 0) this.y = height;
                if (this.y > height) this.y = 0;

                this.energy *= 0.94;
                this.currentSize = this.size + Math.sin(time * this.breathSpeed + this.breathOffset) * 0.7;

                if (mouse.x !== null && mouse.y !== null) {
                    const dx = mouse.x - this.x;
                    const dy = mouse.y - this.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);

                    if (dist < mouse.radius) {
                        const force = (mouse.radius - dist) / mouse.radius;
                        const pushMult = 4 + Math.max(2, mouse.speed * 0.3);
                        this.x -= (dx / (dist || 1)) * force * pushMult * 0.75;
                        this.y -= (dy / (dist || 1)) * force * pushMult * 0.75;
                        this.energy = Math.min(1, this.energy + mouse.speed * 0.04 + force * 0.6);
                    }
                }

                for (let i = 0; i < ripples.length; i++) {
                    const r = ripples[i];
                    const rdx = this.x - r.x;
                    const rdy = this.y - r.y;
                    const rdist = Math.sqrt(rdx * rdx + rdy * rdy);
                    if (Math.abs(rdist - r.radius) < 60) {
                        const power = (1 - Math.abs(rdist - r.radius) / 60) * r.alpha;
                        this.x += (rdx / (rdist || 1)) * power * 20;
                        this.y += (rdy / (rdist || 1)) * power * 20;
                        this.energy = Math.min(1, this.energy + power);
                    }
                }
            }

            draw() {
                if (!ctx) return;
                const alpha = Math.min(1, this.baseAlpha + this.energy * 0.5);
                ctx.fillStyle = this.energy > 0.25 
                    ? `rgba(255, 173, 230, ${alpha})` 
                    : `rgba(154, 168, 255, ${alpha})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, Math.max(0.5, this.currentSize + this.energy * 1.6), 0, Math.PI * 2);
                ctx.fill();
            }
        }

        const particleCount = prefersReducedMotion ? 0 : (isMobile ? 45 : 130);
        const particles: Particle[] = [];
        for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
        }

        let frameCount = 0;

        function cleanup() {
            if (animationFrameId !== null) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }
            window.removeEventListener('resize', resize);
            window.removeEventListener('mousemove', handleMouseMove);
            window.removeEventListener('mouseleave', handleMouseLeave);
            window.removeEventListener('click', handleClick);
        }

        function animate() {
            // Guard: If canvas is detached from DOM (page switched via Swup), stop and clean up
            if (!document.getElementById('bg-canvas') || !ctx) {
                cleanup();
                return;
            }

            frameCount++;
            ctx.clearRect(0, 0, width, height);

            if (mouse.targetX !== null && mouse.targetY !== null) {
                if (mouse.x === null || mouse.y === null) {
                    mouse.x = mouse.targetX;
                    mouse.y = mouse.targetY;
                } else {
                    const dx = mouse.targetX - mouse.x;
                    const dy = mouse.targetY - mouse.y;
                    mouse.speed = Math.sqrt(dx * dx + dy * dy);
                    mouse.x += dx * 0.15;
                    mouse.y += dy * 0.15;
                }

                const mx = mouse.x;
                const my = mouse.y;
                if (mx !== null && my !== null) {
                    // Spotlight cursor glow
                    const gradient = ctx.createRadialGradient(mx, my, 0, mx, my, 220);
                    gradient.addColorStop(0, 'rgba(154, 168, 255, 0.22)');
                    gradient.addColorStop(0.5, 'rgba(255, 173, 230, 0.08)');
                    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
                    ctx.fillStyle = gradient;
                    ctx.beginPath();
                    ctx.arc(mx, my, 220, 0, Math.PI * 2);
                    ctx.fill();
                }
            } else {
                mouse.speed = 0;
            }

            // Ripples render
            for (let i = ripples.length - 1; i >= 0; i--) {
                const r = ripples[i];
                r.radius += 8;
                r.alpha *= 0.94;
                if (r.alpha < 0.02 || r.radius > r.maxRadius) {
                    ripples.splice(i, 1);
                    continue;
                }
                ctx.strokeStyle = `rgba(154, 168, 255, ${r.alpha})`;
                ctx.lineWidth = 1.8;
                ctx.beginPath();
                ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
                ctx.stroke();
            }

            // Constellation connecting lines
            for (let i = 0; i < particles.length; i++) {
                if (mouse.x !== null && mouse.y !== null) {
                    const mdx = particles[i].x - mouse.x;
                    const mdy = particles[i].y - mouse.y;
                    const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
                    if (mdist < 180) {
                        ctx.strokeStyle = `rgba(154, 168, 255, ${(1 - mdist / 180) * 0.6})`;
                        ctx.lineWidth = 1.1;
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(mouse.x, mouse.y);
                        ctx.stroke();
                    }
                }

                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < 135) {
                        const lineAlpha = (1 - dist / 135) * 0.4;
                        ctx.strokeStyle = (particles[i].energy > 0.3 || particles[j].energy > 0.3)
                            ? `rgba(255, 173, 230, ${lineAlpha * 1.6})`
                            : `rgba(154, 168, 255, ${lineAlpha})`;
                        ctx.lineWidth = 0.9;
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.stroke();
                    }
                }
            }

            particles.forEach((p) => {
                p.update(frameCount);
                p.draw();
            });

            animationFrameId = requestAnimationFrame(animate);
        }

        if (!prefersReducedMotion) {
            animate();
        }
    }

    // Run on initial page load
    setupBackgroundCanvas();

    // Re-run whenever Swup navigates back to Home
    document.addEventListener('swup:page:view', () => {
        setupBackgroundCanvas();
    });
</script>
