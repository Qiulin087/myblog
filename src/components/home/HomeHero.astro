---
import { url } from "@utils/url-utils";
---

<div class="hero">
    <h1 class="title">你好，这里是秋林。</h1>
    <p class="sub">记录一些想法，慢慢理解世界，也收藏生活。</p>
    <a class="cta" href={url("/journal/")}>
        浏览我的记录 <span class="arrow" aria-hidden="true">↗</span>
    </a>
</div>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        flex: 1;
        padding: 3rem 0;
    }

    .title {
        margin: 0;
        font-size: clamp(1.875rem, 5vw, 3rem);
        font-weight: 600;
        letter-spacing: -0.015em;
        line-height: 1.25;
        color: var(--sp-ink);
    }

    .sub {
        margin: 1.25rem 0 0;
        font-size: clamp(0.9375rem, 2vw, 1.0625rem);
        line-height: 1.9;
        color: var(--sp-sub);
        max-width: 34em;
    }

    .cta {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: 2.75rem;
        padding: 0.8125rem 1.875rem;
        border-radius: 12px;
        background: var(--sp-btn);
        color: var(--sp-btn-ink);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    .cta .arrow {
        font-size: 0.875em;
        transition: transform 0.2s ease;
    }

    .cta:hover,
    .cta:focus-visible {
        background: color-mix(in srgb, var(--sp-btn) 82%, var(--sp-ink));
    }

    .cta:hover .arrow,
    .cta:focus-visible .arrow {
        transform: translate(1px, -1px);
    }

    .cta:active {
        transform: translateY(1px);
    }

    @media (max-width: 640px) {
        .hero {
            padding: 2.5rem 0;
        }

        .cta {
            margin-top: 2.25rem;
            width: 100%;
            max-width: 20rem;
            justify-content: center;
        }
    }
</style>
