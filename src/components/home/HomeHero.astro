---
import { url } from "@utils/url-utils";
import { profileConfig } from "@/config";

const status = profileConfig.status;
---

<section class="relative w-full pt-10 pb-6 md:pt-16 md:pb-10 overflow-hidden bg-transparent">
    <div class="max-w-4xl mx-auto px-6 relative z-10 flex flex-col items-center text-center gap-5">
        <!-- 翠绿微状态呼吸胶囊 -->
        {
            status?.enable && (
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/70 dark:bg-surface-container-high/85 backdrop-blur-md text-emerald-600 dark:text-primary text-xs font-semibold shadow-md dark:shadow-[0_0_20px_rgba(154,168,255,0.2)] border border-emerald-500/20 dark:border-primary/25 hover:border-emerald-500/40 dark:hover:border-primary/50 transition-all animate-fade-in-up">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 dark:bg-green-400"></span>
                    </span>
                    <span class="tracking-wide">{status.text}</span>
                </div>
            )
        }

        <!-- 主标金句（上下半句严格居中对齐） -->
        <h1 class="w-full text-center text-2xl sm:text-3xl md:text-4xl lg:text-[2.75rem] font-bold tracking-tight text-slate-900 dark:text-on-surface leading-tight animate-fade-in-up [animation-delay:150ms] drop-shadow-sm dark:drop-shadow-[0_2px_20px_rgba(154,168,255,0.3)]">
            <span class="block w-full text-center">如果庞大的世界不能稀释痛苦，</span>
            <span class="block w-full text-center mt-1.5 sm:mt-2.5">就在微小的瞬间感受幸福</span>
        </h1>

        <!-- 副标题 -->
        <p class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-on-surface-variant max-w-2xl font-normal leading-relaxed animate-fade-in-up [animation-delay:300ms]">
            {profileConfig.bio || "秋林的博客，记录生活与学习，慢慢理解世界"}
        </p>

        <!-- 主行动入口按钮 (带 Shimmer 扫光) -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-3 animate-fade-in-up [animation-delay:450ms]">
            <a
                class="relative group overflow-hidden px-8 py-3.5 rounded-full bg-indigo-600 dark:bg-primary-container text-white dark:text-on-primary-container font-medium text-base shadow-[0_4px_16px_rgba(79,70,229,0.3)] dark:shadow-[0_0_28px_rgba(137,153,255,0.45)] hover:shadow-[0_6px_24px_rgba(79,70,229,0.4)] dark:hover:shadow-[0_0_36px_rgba(137,153,255,0.65)] hover:scale-105 active:scale-95 transition-all duration-300 border border-white/20"
                href={url("/journal/")}
            >
                <!-- 光扫动效层 -->
                <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/40 to-transparent -translate-x-full group-hover:animate-shimmer pointer-events-none"></span>
                <span class="relative z-10 flex items-center gap-2">
                    <span>浏览我的记录</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
                </span>
            </a>
        </div>
    </div>
</section>

<style>
    .wave:hover {
        animation: wave-hand 1.2s ease infinite;
    }

    @keyframes wave-hand {
        0%, 100% { transform: rotate(0deg); }
        20% { transform: rotate(14deg); }
        40% { transform: rotate(-8deg); }
        60% { transform: rotate(14deg); }
        80% { transform: rotate(-4deg); }
    }
</style>
