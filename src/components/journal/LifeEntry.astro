---
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import type { JournalItem } from "@/lib/journal";

interface Props {
	item: Extract<JournalItem, { type: "life" }>;
}
const { item } = Astro.props;

const count = item.photos.length;
const gridClass =
	count === 1 ? "grid-1" : count === 2 || count === 4 ? "grid-2" : "grid-3";
---

<article class="life-item">
    <div class="meta">
        <span class="badge badge-life">生活记录</span>
        <time datetime={item.date.toISOString()}>{formatDateToYYYYMMDD(item.date)}</time>
    </div>

    {item.text && <p class="text">{item.text}</p>}

    {
        count > 0 && (
            <div class={`life-photos ${gridClass}`}>
                {item.photos.map((src, index) => (
                    <div class="photo-wrapper">
                        <img
                            src={src}
                            alt={`生活记录照片 ${index + 1}`}
                            loading="lazy"
                            class="life-photo"
                        />
                    </div>
                ))}
            </div>
        )
    }
</article>

<style>
    .life-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .meta {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.8125rem;
        color: var(--sp-sub, #587689);
        font-variant-numeric: tabular-nums;
    }

    :global(.dark) .meta {
        color: var(--sp-sub, #8ba2b5);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.125rem 0.5rem;
        border-radius: 6px;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        line-height: 1.25;
    }

    .badge-life {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    :global(.dark) .badge-life {
        background: rgba(251, 191, 36, 0.15);
        color: #fbbf24;
    }

    .text {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.8;
        color: var(--sp-ink, #2d485d);
        white-space: pre-line;
    }

    :global(.dark) .text {
        color: var(--sp-ink, #cfdee9);
    }

    /* 多图网格排版系统 */
    .life-photos {
        display: grid;
        gap: 0.5rem;
        margin-top: 0.375rem;
        width: 100%;
        max-width: 38rem;
    }

    .grid-1 {
        grid-template-columns: 1fr;
        max-width: 24rem;
    }

    .grid-1 .photo-wrapper {
        aspect-ratio: auto;
        max-height: 22rem;
    }

    .grid-1 .life-photo {
        max-height: 22rem;
        width: auto;
        object-fit: contain;
    }

    .grid-2 {
        grid-template-columns: repeat(2, 1fr);
        max-width: 28rem;
    }

    .grid-2 .photo-wrapper {
        aspect-ratio: 1 / 1;
    }

    .grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .grid-3 .photo-wrapper {
        aspect-ratio: 1 / 1;
    }

    .photo-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.03);
        border: 1px solid var(--line-color, rgba(0, 0, 0, 0.06));
    }

    :global(.dark) .photo-wrapper {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.06);
    }

    .life-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        cursor: zoom-in;
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .photo-wrapper:hover .life-photo {
        transform: scale(1.05);
    }

    @media (max-width: 640px) {
        .life-photos {
            gap: 0.375rem;
        }

        .grid-1 {
            max-width: 100%;
        }

        .grid-2 {
            max-width: 100%;
        }
    }
</style>
