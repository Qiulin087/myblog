---
import type { JournalItem } from "@/lib/journal";
import LearningEntry from "./LearningEntry.astro";
import LifeEntry from "./LifeEntry.astro";
import ThoughtEntry from "./ThoughtEntry.astro";

interface Props {
	items: JournalItem[];
}
const { items } = Astro.props;

const counts = {
	all: items.length,
	post: items.filter((i) => i.type === "post").length,
	learning: items.filter((i) => i.type === "learning").length,
	life: items.filter((i) => i.type === "life").length,
};
---

<section class="journal-feed">
    <div class="filter-wrapper">
        <input type="radio" id="ft-all" name="jfilter" class="ft" checked />
        <label for="ft-all" class="ft-label">
            <span>全部</span>
            <span class="count">{counts.all}</span>
        </label>

        <input type="radio" id="ft-post" name="jfilter" class="ft" />
        <label for="ft-post" class="ft-label">
            <span>随笔</span>
            <span class="count">{counts.post}</span>
        </label>

        <input type="radio" id="ft-learning" name="jfilter" class="ft" />
        <label for="ft-learning" class="ft-label">
            <span>学习理解</span>
            <span class="count">{counts.learning}</span>
        </label>

        <input type="radio" id="ft-life" name="jfilter" class="ft" />
        <label for="ft-life" class="ft-label">
            <span>生活记录</span>
            <span class="count">{counts.life}</span>
        </label>

        <div class="feed-list">
            {
                items.map((item) => (
                    <div class="entry-card" data-type={item.type}>
                        {item.type === "post" && <ThoughtEntry item={item} />}
                        {item.type === "learning" && <LearningEntry item={item} />}
                        {item.type === "life" && <LifeEntry item={item} />}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .journal-feed {
        padding: 1.5rem 2rem 2.5rem;
    }

    .filter-wrapper {
        position: relative;
    }

    /* 纯 CSS 驱动的无延迟筛选 */
    .ft {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .ft-label {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.45rem 1rem;
        margin: 0 0.5rem 0.875rem 0;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.03);
        border: 1px solid var(--line-color, rgba(0, 0, 0, 0.08));
        color: var(--sp-sub, #587689);
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        user-select: none;
        backdrop-filter: blur(8px);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    :global(.dark) .ft-label {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
        color: var(--sp-sub, #8ba2b5);
    }

    .ft-label .count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.08rem 0.45rem;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.06);
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
    }

    :global(.dark) .ft-label .count {
        background: rgba(255, 255, 255, 0.08);
    }

    .ft-label:hover {
        color: var(--primary);
        border-color: var(--primary);
        transform: translateY(-1px);
        background: color-mix(in srgb, var(--primary) 8%, transparent);
    }

    .ft:focus-visible + .ft-label {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }

    /* 激活态的高级渐变与投影 */
    .ft#ft-all:checked ~ .ft-label[for="ft-all"],
    .ft#ft-post:checked ~ .ft-label[for="ft-post"],
    .ft#ft-learning:checked ~ .ft-label[for="ft-learning"],
    .ft#ft-life:checked ~ .ft-label[for="ft-life"] {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
        box-shadow: 0 3px 12px -2px oklch(0.7 0.14 var(--hue) / 0.45);
        transform: translateY(-1px);
    }

    .ft#ft-all:checked ~ .ft-label[for="ft-all"] .count,
    .ft#ft-post:checked ~ .ft-label[for="ft-post"] .count,
    .ft#ft-learning:checked ~ .ft-label[for="ft-learning"] .count,
    .ft#ft-life:checked ~ .ft-label[for="ft-life"] .count {
        background: rgba(255, 255, 255, 0.28);
        color: white;
    }

    /* 联动筛选 */
    .ft#ft-post:checked ~ .feed-list .entry-card:not([data-type="post"]),
    .ft#ft-learning:checked ~ .feed-list .entry-card:not([data-type="learning"]),
    .ft#ft-life:checked ~ .feed-list .entry-card:not([data-type="life"]) {
        display: none;
    }

    .feed-list {
        margin-top: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
    }

    /* 优雅的微卡片容器 */
    .entry-card {
        padding: 1.25rem 1.375rem;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.45);
        border: 1px solid var(--line-color, rgba(0, 0, 0, 0.06));
        backdrop-filter: blur(8px);
        transition:
            transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            border-color 0.25s ease,
            background-color 0.25s ease;
    }

    :global(.dark) .entry-card {
        background: rgba(255, 255, 255, 0.02);
        border-color: rgba(255, 255, 255, 0.06);
    }

    .entry-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--primary) 35%, transparent);
        box-shadow: 0 6px 20px -4px rgba(0, 0, 0, 0.05);
        background: rgba(255, 255, 255, 0.85);
    }

    :global(.dark) .entry-card:hover {
        background: rgba(255, 255, 255, 0.04);
        box-shadow: 0 6px 20px -4px rgba(0, 0, 0, 0.35);
        border-color: color-mix(in srgb, var(--primary) 45%, transparent);
    }

    @media (max-width: 640px) {
        .journal-feed {
            padding: 1.25rem 1rem 2rem;
        }

        .entry-card {
            padding: 1rem 1rem;
            border-radius: 12px;
        }
    }
</style>
