---
import type { JournalItem } from "@/lib/journal";
import LearningEntry from "./LearningEntry.astro";
import LifeEntry from "./LifeEntry.astro";
import ThoughtEntry from "./ThoughtEntry.astro";

interface Props {
	items: JournalItem[];
}
const { items } = Astro.props;
---

<section class="feed">
    <input type="radio" id="ft-all" name="jfilter" class="ft" checked />
    <label for="ft-all" class="ft-label">全部</label>
    <input type="radio" id="ft-post" name="jfilter" class="ft" />
    <label for="ft-post" class="ft-label">随笔</label>
    <input type="radio" id="ft-learning" name="jfilter" class="ft" />
    <label for="ft-learning" class="ft-label">学习理解</label>
    <input type="radio" id="ft-life" name="jfilter" class="ft" />
    <label for="ft-life" class="ft-label">生活记录</label>

    <div class="list">
        {
            items.map((item) => (
                <div class="entry" data-type={item.type}>
                    {item.type === "post" && <ThoughtEntry item={item} />}
                    {item.type === "learning" && <LearningEntry item={item} />}
                    {item.type === "life" && <LifeEntry item={item} />}
                </div>
            ))
        }
    </div>
</section>

<style>
    .feed {
        margin-top: 2.5rem;
    }

    /* 筛选：纯 CSS（radio + 相邻选择器），无客户端脚本，Swup 切换后依然可用 */
    .ft {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .ft-label {
        display: inline-flex;
        align-items: center;
        padding: 0.375rem 1rem;
        margin: 0 0.5rem 0.5rem 0;
        border-radius: 999px;
        background: var(--sp-chip);
        border: 1px solid var(--sp-line);
        color: var(--sp-sub);
        font-size: 0.8125rem;
        cursor: pointer;
        user-select: none;
        transition:
            color 0.2s ease,
            border-color 0.2s ease;
    }

    .ft-label:hover {
        color: var(--sp-accent-strong);
        border-color: var(--sp-accent);
    }

    .ft:focus-visible + .ft-label {
        outline: 2px solid var(--sp-accent);
        outline-offset: 2px;
    }

    .ft#ft-all:checked ~ .ft-label[for="ft-all"],
    .ft#ft-post:checked ~ .ft-label[for="ft-post"],
    .ft#ft-learning:checked ~ .ft-label[for="ft-learning"],
    .ft#ft-life:checked ~ .ft-label[for="ft-life"] {
        background: var(--sp-btn);
        border-color: var(--sp-btn);
        color: var(--sp-btn-ink);
    }

    .ft#ft-post:checked ~ .list .entry:not([data-type="post"]),
    .ft#ft-learning:checked ~ .list .entry:not([data-type="learning"]),
    .ft#ft-life:checked ~ .list .entry:not([data-type="life"]) {
        display: none;
    }

    .list {
        margin-top: 1.5rem;
    }

    .entry {
        padding: 1.375rem 0 1.5rem;
        border-top: 1px solid var(--sp-line);
    }

    .list .entry:first-child {
        border-top: none;
        padding-top: 0.5rem;
    }
</style>
