---
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import type { JournalItem } from "@/lib/journal";

interface Props {
	item: Extract<JournalItem, { type: "learning" }>;
}
const { item } = Astro.props;
---

<article class="learning">
    <p class="meta">
        <time datetime={item.date.toISOString()}>{formatDateToYYYYMMDD(item.date)}</time>
        <span class="type">学习理解</span>
    </p>
    <h2 class="title"><a href={item.url}>{item.title}</a></h2>
    {item.description && <p class="desc">{item.description}</p>}
</article>

<style>
    .meta {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        margin: 0 0 0.375rem;
        font-size: 0.8125rem;
        color: var(--sp-sub);
        font-variant-numeric: tabular-nums;
    }

    .type {
        color: var(--sp-accent-strong);
        font-size: 0.75rem;
    }

    .title {
        margin: 0;
        font-size: 1.0625rem;
        font-weight: 500;
        line-height: 1.55;
    }

    .title a {
        color: var(--sp-ink);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .title a:hover,
    .title a:focus-visible {
        color: var(--sp-accent-strong);
    }

    .desc {
        margin: 0.375rem 0 0;
        font-size: 0.875rem;
        line-height: 1.8;
        color: var(--sp-sub);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
