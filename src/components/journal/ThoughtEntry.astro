---
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import type { JournalItem } from "@/lib/journal";

interface Props {
	item: Extract<JournalItem, { type: "post" }>;
}
const { item } = Astro.props;
---

<article class="thought-item group">
    <div class="meta">
        <span class="badge badge-post">随笔</span>
        <time datetime={item.date.toISOString()}>{formatDateToYYYYMMDD(item.date)}</time>
    </div>
    <h2 class="title">
        <a href={item.url} class="title-link">
            <span>{item.title}</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
    </h2>
    {item.description && <p class="desc">{item.description}</p>}
</article>

<style>
    .thought-item {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .meta {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.8125rem;
        color: var(--sp-sub, #587689);
        font-variant-numeric: tabular-nums;
    }

    :global(.dark) .meta {
        color: var(--sp-sub, #8ba2b5);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.125rem 0.5rem;
        border-radius: 6px;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        line-height: 1.25;
    }

    .badge-post {
        background: color-mix(in srgb, var(--primary) 12%, transparent);
        color: var(--primary);
    }

    .title {
        margin: 0.125rem 0 0;
        font-size: 1.0625rem;
        font-weight: 600;
        line-height: 1.5;
    }

    .title-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        color: var(--sp-ink, #2d485d);
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    :global(.dark) .title-link {
        color: var(--sp-ink, #cfdee9);
    }

    .arrow {
        display: inline-block;
        font-size: 0.875rem;
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        color: var(--primary);
    }

    .title-link:hover,
    .title-link:focus-visible {
        color: var(--primary);
        transform: translateX(2px);
    }

    .title-link:hover .arrow,
    .title-link:focus-visible .arrow {
        opacity: 1;
        transform: translateX(0);
    }

    .desc {
        margin: 0.25rem 0 0;
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--sp-sub, #587689);
    }

    :global(.dark) .desc {
        color: var(--sp-sub, #8ba2b5);
    }
</style>
